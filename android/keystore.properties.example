# Copy this file to keystore.properties (in this folder) and fill it in to sign release builds.
# keystore.properties holds passwords, so it is git-ignored. Never commit it or the .jks key.
#
# Keep the .jks file and its passwords backed up somewhere safe (e.g. a password manager):
# every future update of the Android app must be signed with this same key.

# Full path to the key, with forward slashes
storeFile=C:/Users/you/keys/worksheets-release.jks
storePassword=
keyAlias=worksheets
keyPassword=
