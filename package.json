{
  "name": "my-app",
  "version": "1.7.0",
  "description": "",
  "main": "main.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@capacitor/cli": "^8.5.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "katex": "0.19.1",
    "marked": "18.1.2",
    "pdfjs-dist": "6.4.299"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "build:web": "node scripts/build-web.js",
    "android": "node scripts/build-web.js --android && cap sync android",
    "build:vendor": "node scripts/build-vendor.js"
  },
  "build": {
    "appId": "com.xavierhoward.todo",
    "productName": "Worksheets",
    "icon": "icon.png",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "sync.js",
      "mobile.js",
      "web.js",
      "script.js",
      "claude.js",
      "vendor/**",
      "style.css",
      "icon.png",
      "!node_modules/@capacitor/**",
      "!node_modules/@capacitor-community/**",
      "!node_modules/@capacitor-mlkit/**",
      "!node_modules/capacitor-email-composer/**",
      "!node_modules/@techstark/**",
      "!node_modules/@pdf-lib/**",
      "!node_modules/pdf-lib/**",
      "node_modules/pdf-lib/dist/pdf-lib.min.js"
    ],
    "fileAssociations": [
      {
        "ext": "todo",
        "name": "Worksheets export",
        "description": "Worksheets tasks export",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "reivaxFast",
        "repo": "Maths-sheets-todo"
      }
    ]
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor-mlkit/document-scanner": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "@techstark/opencv-js": "4.12.0-release.1",
    "capacitor-email-composer": "^8.0.0",
    "electron-updater": "^6.8.11",
    "pdf-lib": "1.17.1"
  }
}
