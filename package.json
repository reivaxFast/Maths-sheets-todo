{
  "name": "my-app",
  "version": "1.2.0",
  "description": "",
  "main": "main.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "build:web": "node scripts/build-web.js",
    "android": "npm run build:web && cap sync android"
  },
  "build": {
    "appId": "com.xavierhoward.todo",
    "productName": "Worksheets",
    "icon": "icon.png",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "sync.js",
      "mobile.js",
      "script.js",
      "style.css",
      "icon.png",
      "!node_modules/@capacitor/**",
      "!node_modules/@capacitor-community/**"
    ],
    "fileAssociations": [
      {
        "ext": "todo",
        "name": "Worksheets export",
        "description": "Worksheets tasks export",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "^2.118.0"
  }
}
